<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nikita.mixdownload</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/nikita/Claude/Projects/MixDownload/mixdownload.py</string>
    </array>

    <!-- Lance tous les jours a 18h00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Si le Mac etait eteint/endormi a 20h00, lance des le reveil -->
    <key>RunAtLoad</key>
    <false/>

    <!-- yt-dlp / ffmpeg sont installes via Homebrew : on ajoute leurs dossiers au PATH -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/nikita/Claude/Projects/MixDownload</string>

    <key>StandardOutPath</key>
    <string>/Users/nikita/Claude/Projects/MixDownload/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nikita/Claude/Projects/MixDownload/launchd.err.log</string>
</dict>
</plist>
